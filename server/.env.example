# Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/campus_event_hub?schema=public"

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="REPLACE_WITH_A_STRONG_256_BIT_SECRET_KEY_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ─── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN="http://localhost:3000"

# ─── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECRET="REPLACE_WITH_ANOTHER_STRONG_SECRET_FOR_COOKIE_SIGNING"
